<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Coordenadas Maven: identifican al proyecto y producen GalenosSV.war. -->
    <groupId>sv.edu.ues.occingenieriappi115_2026.salud</groupId>
    <artifactId>GalenosSV</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>war</packaging>

    <name>GalenosSV</name>

    <!-- Versiones centralizadas para una compilación reproducible con Java 21. -->
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <jakartaee.version>11.0.0</jakartaee.version>
        <openliberty.version>26.0.0.8</openliberty.version>
        <liberty.install.dir>${user.home}/openliberty/wlp</liberty.install.dir>
        <liberty.maven.plugin.version>3.12.1</liberty.maven.plugin.version>
        <liberty.server.name>GalenosSV</liberty.server.name>
        <postgresql.jdbc.version>42.7.4</postgresql.jdbc.version>

        <!-- Testing -->
        <junit.version>6.1.3</junit.version>
        <mockito.version>5.23.0</mockito.version>
        <jacoco.version>0.8.15</jacoco.version>
    </properties>

    <dependencies>
        <!-- API Jakarta EE disponible al compilar; Liberty la aporta en ejecución. -->
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-api</artifactId>
            <version>${jakartaee.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Driver JDBC provisto como biblioteca externa del servidor, no dentro del WAR. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.jdbc.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Componentes JSF PrimeFaces compilados para el namespace Jakarta. -->
        <dependency>
            <groupId>org.primefaces</groupId>
            <artifactId>primefaces</artifactId>
            <version>15.0.17</version>
            <classifier>jakarta</classifier>
            <scope>provided</scope>
        </dependency>

        <!-- JUnit ejecuta las pruebas unitarias con Surefire. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Mockito crea dobles de EntityManager, Criteria y DAO en las pruebas. -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- El artefacto final se llama GalenosSV.war. -->
        <finalName>${project.artifactId}</finalName>

        <plugins>

            <!-- Compila fuentes y pruebas usando las APIs de Java 21. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <!-- Surefire descubre y ejecuta las pruebas JUnit durante test/package. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>

            <!-- Empaqueta clases, recursos y webapp en formato WAR. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>

            <!-- JaCoCo instrumenta las pruebas y genera el reporte de cobertura. -->
            <!-- Copia PrimeFaces a la biblioteca común de la instalación existente de Liberty. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
            Utiliza una instalación existente de Open Liberty, copia el driver
            PostgreSQL y permite arrancar con mvn liberty:run. Comandos principales:
            mvn test ejecuta pruebas; mvn clean package limpia y crea el WAR;
            mvn liberty:run inicia el servidor y despliega la aplicación.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-primefaces-to-liberty</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.primefaces</groupId>
                                    <artifactId>primefaces</artifactId>
                                    <version>15.0.17</version>
                                    <classifier>jakarta</classifier>
                                    <type>jar</type>
                                    <outputDirectory>${liberty.install.dir}/usr/shared/resources/primefaces</outputDirectory>
                                    <destFileName>primefaces-15.0.17-jakarta.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <overWriteIfNewer>true</overWriteIfNewer>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>io.openliberty.tools</groupId>
                <artifactId>liberty-maven-plugin</artifactId>
                <version>${liberty.maven.plugin.version}</version>
                <configuration>
                    <installDirectory>${liberty.install.dir}</installDirectory>
                    <serverName>${liberty.server.name}</serverName>
                    <copyDependencies>
                        <dependencyGroup>
                            <location>jdbc</location>
                            <dependency>
                                <groupId>org.postgresql</groupId>
                                <artifactId>postgresql</artifactId>
                                <version>${postgresql.jdbc.version}</version>
                                <type>jar</type>
                            </dependency>
                        </dependencyGroup>
                    </copyDependencies>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
