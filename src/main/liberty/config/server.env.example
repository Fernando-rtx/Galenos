# Copy this file to server.env and fill local values.
# Do not commit server.env.

HTTP_PORT=9080
HTTPS_PORT=9443

POSTGRESQL_DB_HOST=localhost
POSTGRESQL_DB_PORT=5432
POSTGRESQL_DB_NAME=universidad
POSTGRESQL_DB_USER=your_database_user
POSTGRESQL_DB_PASSWORD=your_database_password

# Optional when the JDBC driver is provided outside Maven copyDependencies.
# POSTGRESQL_JDBC_DRIVER_DIR=/path/to/openliberty/usr/shared/resources/postgresql
