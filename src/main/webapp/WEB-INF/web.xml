<?xml version="1.0" encoding="UTF-8"?>
<web-app version="6.0" xmlns="https://jakarta.ee/xml/ns/jakartaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd">
    <!-- Development muestra diagnósticos detallados de Faces durante el desarrollo. -->
    <context-param>
        <param-name>jakarta.faces.PROJECT_STAGE</param-name>
        <param-value>Development</param-value>
    </context-param>
    <!-- Faces Servlet ejecuta el ciclo restaurar/procesar/validar/invocar/renderizar. -->
    <servlet>
        <servlet-name>Faces Servlet</servlet-name>
        <servlet-class>jakarta.faces.webapp.FacesServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <!-- Todas las vistas .xhtml pasan por Jakarta Faces. -->
    <servlet-mapping>
        <servlet-name>Faces Servlet</servlet-name>
        <url-pattern>*.xhtml</url-pattern>
    </servlet-mapping>
    <!-- Duración de la sesión que, entre otros datos, conserva IdiomaBean. -->
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
    <!-- Destino de bienvenida declarado actualmente; este comentario no corrige su ruta. -->
    <welcome-file-list>
        <welcome-file>paginas/CambiarRol.xhtml</welcome-file>
    </welcome-file-list>
    <error-page><error-code>401</error-code><location>/rest-auth-error</location></error-page>
    <error-page><error-code>403</error-code><location>/rest-auth-error</location></error-page>
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Gestion sintetica autenticada</web-resource-name>
            <url-pattern>/resources/v2/*</url-pattern>
            <http-method>GET</http-method><http-method>HEAD</http-method>
            <http-method>POST</http-method><http-method>PUT</http-method><http-method>DELETE</http-method>
        </web-resource-collection>
        <auth-constraint><role-name>galenos-demo-read</role-name><role-name>galenos-demo-write</role-name></auth-constraint>
    </security-constraint>
    <login-config><auth-method>BASIC</auth-method><realm-name>GalenosDemo</realm-name></login-config>
    <security-role><role-name>galenos-demo-read</role-name></security-role>
    <security-role><role-name>galenos-demo-write</role-name></security-role>
</web-app>
