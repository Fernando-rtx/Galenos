# Optional: copy to demo.env. Shell environment takes precedence.
# No credentials here; the runner generates them privately in .galenos-demo/.
GALENOS_DEMO_HTTP_PORT=19081
GALENOS_DEMO_HTTPS_PORT=19444
GALENOS_DEMO_DB_PORT=15432
GALENOS_DEMO_CONTAINER=galenos-demo-db
GALENOS_CORS_ORIGINS=http://localhost:3000
GALENOS_CLINIC_TIME_ZONE=America/El_Salvador

# Optional paths; otherwise use JAVA_HOME/Java 21 on PATH or the local toolchain.
# GALENOS_JAVA_HOME=/path/to/jdk-21
# GALENOS_MAVEN_REPO=/path/to/.m2/repository
